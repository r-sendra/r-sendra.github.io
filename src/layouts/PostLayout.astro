---
import Layout from "./Layout.astro";

const { post } = Astro.props;
const { title, description, type, date, tags } = post.data;

const typeLabels = { paper: "Paper", reflection: "Reflection", project: "Project" };
const dateStr = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Layout
  title={`${title} — Rafael Sendra-Arranz`}
  description={description}
  current="posts"
>
  <article class="mx-auto max-w-2xl px-6 pt-28 pb-16">
    <a href="/posts" class="font-mono text-xs text-accent hover:underline">
      ← back to posts
    </a>

    <header class="mt-6">
      <p class="eyebrow">{typeLabels[type] ?? type}</p>
      <h1 class="spike mt-2 font-display text-5xl uppercase leading-none text-ink sm:text-6xl">
        {title}
      </h1>
      <p class="mt-3 font-mono text-xs text-muted">
        {dateStr}{tags.length > 0 ? ` · ${tags.join(" · ")}` : ""}
      </p>
    </header>

    <div class="post-content mt-10">
      <slot />
    </div>
  </article>
</Layout>
