---
// Inline-SVG icon links (no external requests). Pass the `links` object from
// profile.ts and an optional size / class.
import { profile } from "../data/profile";

interface Props {
  class?: string;
  tone?: "dark" | "light";
}
const { class: className = "", tone = "dark" } = Astro.props;
const { links, email } = profile;

// `dark` = ink icons for the paper background; `light` = amber phosphor icons
// for dark CRT / footer backgrounds.
const iconClass =
  tone === "light"
    ? "text-[#ffb000]/70 transition-colors hover:text-[#ffb000]"
    : "text-muted transition-colors hover:text-accent";
---

<div class={`flex items-center gap-3 ${className}`}>
  <a
    href={links.scholar}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Google Scholar"
    class={iconClass}
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
      <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
    </svg>
  </a>

  <a
    href={links.orcid}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="ORCID"
    class={iconClass}
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
      <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378a.868.868 0 1 1 0 1.735.868.868 0 0 1 0-1.735zm.744 3.166v10.65H6.61V7.544h1.503zm2.415 0h4.14c3.944 0 5.68 2.82 5.68 5.33 0 2.73-2.135 5.32-5.66 5.32h-4.16V7.544zm1.503 1.35v7.95h2.5c3.566 0 4.38-2.708 4.38-3.97 0-2.055-1.31-3.98-4.46-3.98h-2.42z"/>
    </svg>
  </a>

  <a
    href={links.github}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="GitHub"
    class={iconClass}
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
      <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.575.106.785-.25.785-.556 0-.274-.01-1-.015-1.965-3.196.695-3.87-1.54-3.87-1.54-.523-1.33-1.277-1.684-1.277-1.684-1.044-.714.08-.699.08-.699 1.154.081 1.762 1.185 1.762 1.185 1.026 1.758 2.693 1.25 3.35.955.104-.743.402-1.25.73-1.538-2.552-.29-5.236-1.276-5.236-5.68 0-1.255.448-2.28 1.183-3.084-.119-.29-.513-1.46.112-3.043 0 0 .965-.309 3.163 1.178a10.98 10.98 0 0 1 2.88-.388c.977.004 1.96.132 2.88.388 2.196-1.487 3.16-1.178 3.16-1.178.627 1.583.233 2.753.114 3.043.737.804 1.182 1.829 1.182 3.084 0 4.415-2.688 5.386-5.248 5.67.413.356.78 1.058.78 2.134 0 1.54-.014 2.782-.014 3.16 0 .308.207.667.79.554A11.503 11.503 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/>
    </svg>
  </a>

  <a
    href={links.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="LinkedIn"
    class={iconClass}
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
    </svg>
  </a>

  <a
    href={`mailto:${email}`}
    aria-label="Email"
    class={iconClass}
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
      <path d="m3 6 9 6 9-6" />
    </svg>
  </a>
</div>
